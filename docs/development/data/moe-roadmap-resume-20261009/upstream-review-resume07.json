  "source_review": {
    "rms_norm": "5e4878e clamps dispatch y/z to device limits and iterates excess channels/samples in shader; changes backend/shader source. No local shape/capture establishes thisoverflow as cause of observed R43/R47/R55/R57/pressure divergences. Separate future B4 test required.",
    "backend_sampling": "a518119 holds backend-sampler graph topology static across ubatches. Current frozen helpers use CPU common_sampler and no llama sampler attached to backend; no asserted fix for these runs.",
    "ggml_acc": "8ae3867 asserts largeoffset<2^30 beforeint32 narrowing; no current case has captured evidence of this fault.",
    "host_views": "e60eff9 changes meta backend handling; current model engine directlyCPU/Vulkan, not adopted.",
    "chat": "8b54361 refactorsAPI/common parser; native R62 uses frozenB1 template/parser and CPU sampler, no updated ABI injected.",
